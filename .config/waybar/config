{
	"height": 20,
	"spacing": 2,

	"gtk-layer-shell": true,

	"modules-left": ["hyprland/workspaces"],
	"modules-right": [ 
	 "hyprland/language",
	 "custom/disk_home",
	 "custom/disk_root",
	 "temperature",
	 "cpu",
	 "memory",
	 "network",
	 "backlight",
	 "pulseaudio",
	 "clock",
	 "battery", 
	 "idle_inhibitor", 
	 "tray"
	],

	"hyprland/workspaces": {
		"disable-scroll": true,
	 	"all-outputs": false,
	 	"format": "{icon}",
		"format-icons": {
			"1":"一",
			"2":"二",
			"3":"三",
			"4":"四",
			"5":"五",
			"6":"六",
			"7":"七",
			"8":"八",
			"9":"九",
			"10":"十",
			"11":"十一",
			"12":"十二",
			"13":"十三",
			"14":"十四",
			"15":"十五",
			"16":"十六",
			"17":"十七",
			"18":"十八",
			"19":"十九",
			"20":"二十",
      "sort-by-number": true
	 	},
    	"persistent-workspaces": 
    	{
     	 	"DP-1": [1, 2, 3, 4, 5],
    		"DP-2": [6, 7, 8, 9, 10]
   		}
	 },

	"custom/disk_home": {
		"format": "/home {} ",
		"interval": 30,
		"exec": "df -h --output=avail $HOME | tail -1 | tr -d ' '"
	},
	"custom/disk_root": {
		"format": "/ {} ",
		"interval": 30,
		"exec": "df -h --output=avail / | tail -1 | tr -d ' '"
	},
    // "hyprland/language": {
    //     "format": "{}",
    //     "max-length": 18
    // },
	"temperature": {
		"thermal-zone": 2,
		"hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
		"critical-threshold": 80,
		"format-critical": "{temperatureC}°C {icon}",
		"format": "<span color='#e88939'>{icon}</span> {temperatureC}°C",
		"format-icons": ["", "", ""]
	},
    "cpu": {
        "format": "CPU {usage}% \uf2db",
        "states": {"warning": 70, "critical": 90 }
    },
	"memory": {
		"format": "ram {used:0.1f}G \uf538"
	},
	"network": {
		"family": "ipv4",
		"format-wifi": "<span color='#589df6'></span> <span color='gray'>{essid}</span> {frequency} <span color='#589df6'>{signaldBm} dB</span> <span color='#589df6'>⇵</span> {bandwidthUpBits}/{bandwidthDownBits}",
		"format-ethernet": "\uf063 {bandwidthDownBits} | \uf062 {bandwidthUpBits} | {ifname}: {ipaddr}/{cidr}",
		"format-linked": "{ifname} (No IP)",
		"format-disconnected": "Disconnected ⚠",
		"format-alt": "{ifname}: {ipaddr}/{cidr}",
		"interval": 5
	},
    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "{icon} {format_source}",
	"format-muted": " {format_source}",
        "format-source": "{volume}% \uf130",
        "format-source-muted": "\uf131",
        "format-icons": {
	  "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
	"clock": {
		"interval": 1,
		"format": "{:%H:%M:%S}",
		"tooltip-format": "{:%Y-%m-%d | %H:%M:%S}"
	},
	"idle_inhibitor": {
		"format": "<span color='#589df6'>{icon}</span>",
		"format-icons": {
			"activated": "",
			"deactivated": ""
		},
		"on-click-right": "hyprlock"
	},
	"tray": {
		"spacing": 10
	},
}
